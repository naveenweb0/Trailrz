datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model AdminUser {
  id           String          @id @default(cuid())
  email        String          @unique
  name         String
  passwordHash String
  role         String          @default("ADMIN")
  isActive     Boolean         @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  auditLogs    AdminAuditLog[]

  @@map("admin_users")
}

model Event {
  id                  String                 @id @default(cuid())
  title               String
  slug                String                 @unique
  shortDescription    String
  fullDescription     String
  category            String
  subcategory         String?
  tags                String                 @default("[]")
  eventType           String                 @default("CURATED")
  isFeatured          Boolean                @default(false)
  isOriginal          Boolean                @default(false)
  mood                String?
  coverImage          String
  city                String
  venueName           String
  fullAddress         String
  googleMapsUrl       String?
  latitude            Float?
  longitude           Float?
  eventDate           DateTime
  startTime           String
  endTime             String?
  bookingOpensAt      DateTime               @default(now())
  bookingClosesAt     DateTime
  ageRestriction      String                 @default("16+")
  highlights          String                 @default("[]")
  whatToExpect        String?
  artistInfo          String?
  rules               String                 @default("[]")
  faqs                String                 @default("[]")
  cancellationPolicy  String?
  accessibilityInfo   String?
  entryInstructions   String?
  metaTitle           String?
  metaDescription     String?
  ogImage             String?
  status              String                 @default("PUBLISHED")
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  images              EventImage[]
  sessions            EventSession[]
  ticketTypes         TicketType[]
  bookings            Booking[]
  reservations        InventoryReservation[]

  @@index([city])
  @@index([category])
  @@index([status])
  @@index([eventDate])
  @@map("events")
}

model EventImage {
  id        String   @id @default(cuid())
  eventId   String
  url       String
  caption   String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("event_images")
}

model EventSession {
  id             String      @id @default(cuid())
  eventId        String
  title          String?
  sessionDate    DateTime
  startTime      String
  endTime        String?
  capacity       Int         @default(100)
  createdAt      DateTime    @default(now())

  event          Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  ticketTypes    TicketType[]

  @@map("event_sessions")
}

model TicketType {
  id             String                 @id @default(cuid())
  eventId        String
  sessionId      String?
  name           String
  description    String?
  price          Int                    @default(0)
  quantityTotal  Int                    @default(100)
  quantitySold   Int                    @default(0)
  maxPerBooking  Int                    @default(10)
  minPerBooking  Int                    @default(1)
  saleStart      DateTime               @default(now())
  saleEnd        DateTime?
  status         String                 @default("ACTIVE")
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  event          Event                  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  session        EventSession?          @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  bookingItems   BookingItem[]
  reservations   InventoryReservation[]
  tickets        Ticket[]

  @@index([eventId])
  @@map("ticket_types")
}

model InventoryReservation {
  id               String      @id @default(cuid())
  reservationToken String      @unique
  eventId          String
  ticketTypeId     String
  quantity         Int
  expiresAt        DateTime
  status           String      @default("PENDING")
  createdAt        DateTime    @default(now())

  event            Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  ticketType       TicketType  @relation(fields: [ticketTypeId], references: [id], onDelete: Cascade)

  @@index([reservationToken])
  @@index([expiresAt])
  @@map("inventory_reservations")
}

model Customer {
  id                     String    @id @default(cuid())
  fullName               String
  email                  String    @unique
  phone                  String
  totalBookings          Int       @default(0)
  totalTicketsPurchased  Int       @default(0)
  totalSpent             Int       @default(0)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  bookings               Booking[]

  @@index([email])
  @@index([phone])
  @@map("customers")
}

model Booking {
  id               String         @id @default(cuid())
  bookingReference String         @unique
  eventId          String
  customerId       String
  customerName     String
  customerEmail    String
  customerPhone    String
  totalQuantity    Int            @default(1)
  subtotal         Int            @default(0)
  convenienceFee   Int            @default(0)
  taxAmount        Int            @default(0)
  totalAmount      Int            @default(0)
  bookingStatus    String         @default("PENDING")
  paymentStatus    String         @default("PENDING")
  reservationToken String?
  notes            String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  event            Event          @relation(fields: [eventId], references: [id], onDelete: Restrict)
  customer         Customer       @relation(fields: [customerId], references: [id], onDelete: Restrict)
  items            BookingItem[]
  tickets          Ticket[]
  payments         Payment[]
  refunds          Refund[]
  notifications    Notification[]

  @@index([bookingReference])
  @@index([customerEmail])
  @@index([customerPhone])
  @@index([eventId])
  @@index([bookingStatus])
  @@index([paymentStatus])
  @@map("bookings")
}

model BookingItem {
  id           String      @id @default(cuid())
  bookingId    String
  ticketTypeId String
  ticketName   String
  quantity     Int
  unitPrice    Int
  subtotal     Int
  createdAt    DateTime    @default(now())

  booking      Booking     @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  ticketType   TicketType  @relation(fields: [ticketTypeId], references: [id], onDelete: Restrict)
  tickets      Ticket[]

  @@map("booking_items")
}

model Ticket {
  id                String       @id @default(cuid())
  ticketNumber      String       @unique
  bookingId         String
  bookingItemId     String
  ticketTypeId      String
  attendeeName      String
  attendeeEmail     String?
  verificationToken String       @unique
  qrPayload         String
  status            String       @default("VALID")
  checkedInAt       DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  booking           Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  bookingItem       BookingItem  @relation(fields: [bookingItemId], references: [id], onDelete: Cascade)
  ticketType        TicketType   @relation(fields: [ticketTypeId], references: [id], onDelete: Restrict)
  checkIn           CheckIn?

  @@index([ticketNumber])
  @@index([verificationToken])
  @@index([status])
  @@map("tickets")
}

model CheckIn {
  id          String   @id @default(cuid())
  ticketId    String   @unique
  scannedBy   String   @default("Admin Gate Scanner")
  scannedAt   DateTime @default(now())
  location    String?
  device      String?
  notes       String?

  ticket      Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@map("check_ins")
}

model Payment {
  id                String    @id @default(cuid())
  bookingId         String
  amount            Int
  currency          String    @default("INR")
  provider          String    @default("RAZORPAY")
  razorpayOrderId   String?
  razorpayPaymentId String?
  razorpaySignature String?
  paymentMethod     String?
  status            String    @default("CREATED")
  rawPayload        String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  booking           Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  refunds           Refund[]

  @@index([razorpayOrderId])
  @@index([razorpayPaymentId])
  @@index([status])
  @@map("payments")
}

model Refund {
  id               String    @id @default(cuid())
  paymentId        String
  bookingId        String
  amount           Int
  reason           String?
  razorpayRefundId String?
  status           String    @default("PENDING")
  processedBy      String?   @default("Admin")
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  payment          Payment   @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  booking          Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("refunds")
}

model Notification {
  id               String    @id @default(cuid())
  bookingId        String
  type             String
  recipient        String
  subject          String?
  content          String
  status           String    @default("PENDING")
  attempts         Int       @default(0)
  lastError        String?
  providerResponse String?
  sentAt           DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  booking          Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([status])
  @@map("notifications")
}

model AdminAuditLog {
  id          String     @id @default(cuid())
  adminUserId String?
  action      String
  entityType  String
  entityId    String?
  details     String?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime   @default(now())

  adminUser   AdminUser? @relation(fields: [adminUserId], references: [id], onDelete: SetNull)

  @@index([action])
  @@index([createdAt])
  @@map("admin_audit_logs")
}

model PlatformSetting {
  id                       Int      @id @default(1)
  platformName             String   @default("TRAILRZ")
  tagline                  String   @default("Life is happening. Go be part of it.")
  logoUrl                  String?
  supportedCities          String   @default("[\"Chandigarh\", \"Mohali\", \"Panchkula\", \"Delhi NCR\", \"Mumbai\", \"Bengaluru\"]")
  eventCategories          String   @default("[\"Music\", \"Food\", \"Comedy\", \"Art & Culture\", \"Workshops\", \"Nightlife\", \"Outdoor\", \"Exclusive\"]")
  convenienceFeePercentage Float    @default(2.5)
  convenienceFeeFixed      Int      @default(2000)
  taxPercentage            Float    @default(18.0)
  bookingExpiryMinutes     Int      @default(10)
  razorpayKeyId            String?  @default("")
  razorpayKeySecret        String?  @default("")
  resendApiKey             String?  @default("")
  resendFromEmail          String?  @default("tickets@trailrz.com")
  whatsappToken            String?  @default("")
  whatsappPhoneNumberId    String?  @default("")
  supportEmail             String   @default("care@trailrz.com")
  supportPhone             String   @default("+91 98765 43210")
  instagramUrl             String   @default("https://instagram.com/trailrz")
  whatsappUrl              String   @default("https://wa.me/919876543210")
  cancellationPolicyDefault String  @default("Free cancellation up to 48 hours before the event start time. 50% refund up to 24 hours before. No refunds within 24 hours of event.")
  termsConditions          String   @default("All tickets are subject to venue rules and verification at the gate.")
  privacyPolicy            String   @default("We respect your privacy and only process booking details for ticketing and support.")
  updatedAt                DateTime @updatedAt

  @@map("platform_settings")
}
