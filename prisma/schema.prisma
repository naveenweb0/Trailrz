datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

enum EventStatus {
  draft
  published
  archived
}

enum BookingStatus {
  held
  confirmed
  expired
  cancelled
  refund_due
  cancelled_by_admin
  refunded
}


enum PaymentStatus {
  none
  created
  paid
  not_required
  refund_initiated
  refunded
  refund_failed
}

enum TicketStatus {
  VALID
  REDEEMED
  VOID
}

enum UserRole {
  superadmin
  admin
  event_manager
  gate_operator
  pending
}

model Event {
  id                 String       @id @default(uuid())
  slug               String       @unique
  title              String
  category           String
  moods              String[]     @default([])
  experienceType     String       @default("") @map("experience_type")
  isOriginal         Boolean      @default(false) @map("is_original")
  shortDescription   String       @default("") @map("short_description")
  description        String       @default("") @db.Text
  organizer          String       @default("")
  city               String
  state              String       @default("")
  venue              String
  address            String       @default("")
  lat                Float?
  lng                Float?
  startAt            DateTime     @map("start_at")
  endAt              DateTime?    @map("end_at")
  bookingOpensAt     DateTime?    @map("booking_opens_at")
  bookingClosesAt    DateTime?    @map("booking_closes_at")
  coverImage         Json?        @map("cover_image") // { url, public_id, alt }
  gallery            Json         @default("[]")      // [{ url, public_id, alt }]
  highlights         String[]     @default([])
  guidelines         String[]     @default([])
  whyAttend          String       @default("") @map("why_attend") @db.Text
  whoShouldAttend    String[]     @default([]) @map("who_should_attend")
  whatToExpect       String[]     @default([]) @map("what_to_expect")
  included           String[]     @default([])
  faqs               Json         @default("[]")      // [{ q, a }]
  cancellationPolicy String       @default("") @map("cancellation_policy") @db.Text
  ageRestriction     String       @default("") @map("age_restriction")
  gateKey            String?      @unique @map("gate_key")
  gatePin            String?      @default("2026") @map("gate_pin")
  status             EventStatus  @default(draft)
  createdBy          String       @default("system") @map("created_by")
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")

  ticketTypes        TicketType[]
  bookings           Booking[]
  tickets            Ticket[]

  @@index([status, startAt])
  @@index([city])
  @@index([category])
  @@map("events")
}

model TicketType {
  id            String    @id @default(uuid())
  eventId       String    @map("event_id")
  name          String
  description   String    @default("")
  price          Int       // in paise (e.g. 150000 = ₹1,500.00)
  bundleEnabled  Boolean   @default(false) @map("bundle_enabled")
  twoTicketPrice Int?      @map("two_ticket_price") // in paise
  bundlePrices   Json      @default("{}") @map("bundle_prices") // manual quantity overrides in paise
  capacity       Int
  sold          Int       @default(0)
  reserved      Int       @default(0)
  maxPerBooking Int       @default(10) @map("max_per_booking")
  saleStartsAt  DateTime? @map("sale_starts_at")
  saleEndsAt    DateTime? @map("sale_ends_at")
  active        Boolean   @default(true)
  sort          Int       @default(0)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  event         Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  tickets       Ticket[]

  @@index([eventId, sort])
  @@map("ticket_types")
}

model Customer {
  id          String    @id @default(uuid())
  email       String    @unique
  name        String
  phone       String
  phoneDigits String    @map("phone_digits")
  lastSeenAt  DateTime  @default(now()) @map("last_seen_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  bookings    Booking[]
  tickets     Ticket[]

  @@index([lastSeenAt(sort: Desc)])
  @@map("customers")
}

model Booking {
  id                String        @id @default(uuid())
  reference         String        @unique // e.g. TRZ-ABC123
  accessKey         String        @map("access_key") // e.g. K-XXXXXXXXXXXXXXXXXXXX
  eventId           String        @map("event_id")
  eventSnapshot     Json          @map("event_snapshot")
  items             Json          // [{ ticket_type_id, name, unit_price, quantity, subtotal }]
  amount            Int           // in paise
  currency          String        @default("INR")
  customerId        String        @map("customer_id")
  customerSnapshot  Json          @map("customer_snapshot")
  status            BookingStatus @default(held)
  paymentStatus     PaymentStatus @default(none) @map("payment_status")
  paymentId         String?       @map("payment_id")
  holdExpiresAt     DateTime      @map("hold_expires_at")
  finalizing        Boolean       @default(false)
  inventoryReleased Boolean       @default(false) @map("inventory_released")
  ticketCount       Int           @default(0) @map("ticket_count")
  confirmedAt       DateTime?     @map("confirmed_at")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  event             Event         @relation(fields: [eventId], references: [id])
  customer          Customer      @relation(fields: [customerId], references: [id])
  tickets           Ticket[]
  payments          Payment[]
  notifications     Notification[]

  @@index([status, holdExpiresAt])
  @@index([eventId, status])
  @@index([customerId])
  @@index([createdAt(sort: Desc)])
  @@index([status, confirmedAt])
  @@map("bookings")
}

model Ticket {
  id               String       @id @default(uuid())
  serial           String       @unique // e.g. TRZ-XXXXXXXXXX
  bookingId        String       @map("booking_id")
  bookingReference String       @map("booking_reference")
  eventId          String       @map("event_id")
  eventTitle       String       @map("event_title")
  ticketTypeId     String       @map("ticket_type_id")
  tierName         String       @map("tier_name")
  holderName       String       @map("holder_name")
  customerId       String       @map("customer_id")
  status           TicketStatus @default(VALID)
  issuedAt         DateTime     @default(now()) @map("issued_at")
  redeemedAt       DateTime?    @map("redeemed_at")
  redeemedBy       String?      @map("redeemed_by")
  redeemedByName   String?      @map("redeemed_by_name")
  redeemedGate     String?      @map("redeemed_gate")
  redeemedMethod   String?      @map("redeemed_method")
  voidReason       String?      @map("void_reason")
  voidedAt         DateTime?    @map("voided_at")
  voidedBy         String?      @map("voided_by")

  booking          Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  event            Event        @relation(fields: [eventId], references: [id])
  ticketType       TicketType   @relation(fields: [ticketTypeId], references: [id])
  customer         Customer     @relation(fields: [customerId], references: [id])

  @@index([bookingId])
  @@index([eventId, status])
  @@index([issuedAt(sort: Desc)])
  @@map("tickets")
}

model Payment {
  id                String    @id @default(uuid())
  bookingId         String    @map("booking_id")
  bookingReference  String    @map("booking_reference")
  customerId        String    @map("customer_id")
  customerName      String    @map("customer_name")
  gateway           String    @default("razorpay")
  orderId           String    @unique @map("order_id")
  paymentId         String?   @unique @map("payment_id")
  amount            Int       // in paise
  currency          String    @default("INR")
  status            String    @default("created") // created, paid, failed, signature_failed, refunded
  refundId          String?   @map("refund_id")
  refundStatus      String?   @map("refund_status") // initiating, initiated, processed, failed
  refundAmount      Int?      @map("refund_amount")
  refundReason      String?   @map("refund_reason")
  refundProcessedAt DateTime? @map("refund_processed_at")
  verifiedBy        String?   @map("verified_by") // signature, webhook
  lastError         String?   @map("last_error") @db.Text
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  booking           Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([createdAt(sort: Desc)])
  @@map("payments")
}

model User {
  id               String   @id @default(uuid())
  userId           String   @unique @map("user_id") // Clerk user ID (e.g. user_xxx)
  email            String
  name             String
  role             UserRole @default(pending)
  assignedEventIds String[] @default([]) @map("assigned_event_ids")
  env              String?  @default("preview") // live, preview
  createdAt        DateTime @default(now()) @map("created_at")

  @@map("users")
}

model Notification {
  id               String   @id @default(uuid())
  channel          String   @default("email")
  kind             String   // booking_confirmation, booking_refunded, broadcast, etc.
  bookingId        String   @map("booking_id")
  bookingReference String   @map("booking_reference")
  eventId          String   @map("event_id")
  to               String
  subject          String
  html             String   @db.Text
  status           String   @default("queued") // queued, sending, sent, delivered, failed, not_configured
  attempts         Int      @default(0)
  providerId       String?  @map("provider_id")
  lastError        String?  @map("last_error") @db.Text
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  booking          Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([createdAt(sort: Desc)])
  @@index([providerId])
  @@map("notifications")
}

model GateScan {
  id           String   @id @default(uuid())
  operatorId   String   @map("operator_id")
  operatorName String?  @map("operator_name")
  eventId      String   @map("event_id")
  gateLabel    String   @map("gate_label")
  result       String   // GRANTED, DUPLICATE, INVALID, WRONG_EVENT
  ticketId     String?  @map("ticket_id")
  method       String   @default("qr") // qr, manual
  at           DateTime @default(now())

  @@index([eventId, operatorId, at])
  @@map("gate_scans")
}

model Subscriber {
  id        String   @id @default(uuid())
  email     String   @unique
  source    String   @default("newsletter")
  consentAt DateTime @default(now()) @map("consent_at")

  @@map("subscribers")
}

model ContactMessage {
  id        String   @id @default(uuid())
  name      String
  email     String
  topic     String
  message   String   @db.Text
  status    String   @default("new")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("contact_messages")
}

model WebhookEvent {
  id     String   @id // Razorpay event ID or payload hash
  source String   @default("razorpay")
  at     DateTime @default(now())

  @@map("webhook_events")
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String   @default("system") @map("actor_id")
  actorEmail String?  @map("actor_email")
  action     String
  target     String
  meta       Json?
  at         DateTime @default(now())

  @@index([at(sort: Desc)])
  @@map("audit_logs")
}

model PlatformSetting {
  id                   String   @id @default("platform")
  platformName         String   @default("TRAILRZ") @map("platform_name")
  supportEmail         String   @default("") @map("support_email")
  supportPhone         String   @default("") @map("support_phone")
  supportedCities      String[] @default(["Chandigarh", "Mohali", "Panchkula"]) @map("supported_cities")
  defaultCity          String   @default("Chandigarh") @map("default_city")
  defaultMaxPerBooking Int      @default(10) @map("default_max_per_booking")
  socials              Json     @default("{}")
  hero                 Json     @default("{}")
  notifyOnBooking      Boolean  @default(true) @map("notify_on_booking")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@map("platform_settings")
}
